# Copy to .env next to compose.yaml (in Dockge, paste into the stack's .env box).
# Only POSTGRES_PASSWORD is required. Settings marked "later" are read once
# that feature ships; setting them now is harmless.

# ---- Required ----

# Password for the bundled Postgres. Letters and numbers only, because it goes
# into a connection URL. Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=

# ---- Optional ----

# Your timezone, for meal plan dates and backup file names.
TZ=America/Chicago

# Port on the host for the web app.
MISE_PORT=3000

# Where to build from: a GitHub branch, tag or commit, or "." for a local checkout.
MISE_BUILD_CONTEXT=https://github.com/kjohnson2719/mise.git#main

# User and group that own ./data/app on the host.
PUID=1000
PGID=1000

# Days of nightly database backups to keep in ./data/backups.
BACKUP_KEEP_DAYS=14

# The address people use to reach Mise from outside, e.g. https://mise.example.com.
# Set it when you turn on the tunnel.
PUBLIC_URL=

# AI providers. You can add them in the app under Settings instead. A key
# set here takes priority and can't be changed in the app.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Mise keeps yt-dlp (which reads TikTok, YouTube and Instagram links) up to
# date by itself. Set to false to stop that.
YTDLP_AUTO_UPDATE=true

# Encrypts API keys saved in the app. If empty, Mise makes a random one in
# ./data/app/secret. Back that file up with the database; without it, saved
# keys have to be entered again.
MISE_SECRET=

# USDA FoodData Central key for calculated nutrition (later), from api.data.gov.
USDA_API_KEY=

# Cloudflare Tunnel token, only if you enable the cloudflared service.
TUNNEL_TOKEN=

# ---- Local development only (npm run dev) ----

# Matches the Postgres started by `npm run db:up`.
DATABASE_URL=postgres://mise:mise@localhost:5432/mise
