{
  "manifest_version": 3,
  "name": "Nourvio",
  "version": "0.1.0",
  "description": "Import recipes into your Nourvio in one click, and keep the shopping list beside you while you shop.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Nourvio",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "sidePanel"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"]
}
