{
  "name": "@merran/server",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "test": "vitest run --project sqlite",
    "typecheck": "tsc",
    "db:migration": "node src/database/make-migration.ts",
    "db:test-postgres": "docker run -d --rm --name merran-test-postgres -e POSTGRES_PASSWORD=merran -p 5433:5432 --tmpfs /var/lib/postgresql postgres:18",
    "test:all": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "^1.6.3",
    "@mikro-orm/core": "^7.2.5",
    "@mikro-orm/migrations": "^7.2.5",
    "@mikro-orm/postgresql": "^7.2.5",
    "@mikro-orm/sql": "^7.2.5",
    "@mikro-orm/sqlite": "^7.2.5",
    "@scalar/hono-api-reference": "^0.12.12",
    "hono": "^4.13.13",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "vitest": "^5.0.4"
  }
}
