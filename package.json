{
  "name": "merran",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm --filter @merran/web build",
    "start": "pnpm --filter @merran/server start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write apps",
    "format:check": "prettier --check apps",
    "merran": "pnpm --filter @merran/server merran"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "7.0.2"
  }
}
